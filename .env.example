# Insurance Partners — environment variables (copy to .env.local; never commit real values).

# Supabase project URL and anon/publishable key. Public by design; access is enforced by RLS.
# Local: `npx supabase start` prints both (API URL and anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Development only (local seed and integration tests). Never set these in Vercel. ---
# Local service-role key from `npx supabase status`. Used ONLY by scripts/seed-dev.mjs and the
# development-only ingestion worker (workers/ingestion, docs/07 §14.1). Never in src/ or the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional name of the ingestion worker in the job queue (default: ingestion-<host>-<pid>).
IPA_WORKER_ID=
# Runtime environment for development-grade implementations (test embedder, "none" reranker):
# local or test. Missing or anything else is treated as production (fail-closed, docs/07 §9.1).
IPA_RUNTIME_ENV=
# Reranker for retrieval (docs/07 §9). Default "none" (development grade; refused outside local/test).
IPA_RERANKER=
# Model for the AI Gateway (docs/08 §3). Default "stub" (development grade, no AI; refused outside local/test).
# No real model is configured in phase 8.
IPA_AI_MODEL=
# Shared password for the fictional seed users (min. 12 characters). Choose your own.
IPA_DEV_SEED_PASSWORD=
# URL of a running app for the route-level integration tests, e.g. http://localhost:3000
IPA_APP_URL=
# Optional: the same app started with IPA_RUNTIME_ENV=production, for the "retrieval unavailable" route test.
IPA_APP_URL_RETRIEVAL_OFF=
