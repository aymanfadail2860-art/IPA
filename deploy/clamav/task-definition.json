{
  "family": "ipa-clamav",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "3072",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ipa-clamav-execution",
  "volumes": [
    {
      "name": "tmp"
    }
  ],
  "containerDefinitions": [
    {
      "name": "clamav",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.eu-central-1.amazonaws.com/ipa-clamav@${CLAMAV_IMAGE_DIGEST}",
      "essential": true,
      "user": "10001:10001",
      "readonlyRootFilesystem": true,
      "privileged": false,
      "linuxParameters": {
        "initProcessEnabled": true,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        }
      },
      "stopTimeout": 30,
      "portMappings": [
        {
          "containerPort": 3310,
          "protocol": "tcp",
          "name": "clamd"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "tmp",
          "containerPath": "/tmp",
          "readOnly": false
        }
      ],
      "environment": [],
      "dockerLabels": {
        "ipa.scanner.revision": "${CLAMAV_IMAGE_TAG}"
      },
      "healthCheck": {
        "command": [
          "CMD",
          "clamdscan",
          "--config-file=/etc/clamav/clamd.conf",
          "--ping",
          "1"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ipa/clamav",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "clamav",
          "mode": "non-blocking",
          "max-buffer-size": "1m"
        }
      }
    }
  ]
}
