# Indstillinger til dokumentimport (beta L3) — skabelon. Runbook: docs/import-runbook.md.
#
# Kopiér filen til din egen mappe uden for repoet, fx ~/ipa-import/ipa-import.env, udfyld den og
# kør: chmod 600 ~/ipa-import/ipa-import.env
#
# Filen må IKKE indeholde adgangskoder eller nøgler, der giver adgang. Importen spørger om din egen
# adgangskode og workerens databaseadgangskode, hver gang den kører, og gemmer dem ingen steder.

# Platformens adresse og offentlige (publishable/anon) nøgle — fra Supabase: Project Settings → API.
IPA_IMPORT_SUPABASE_URL=https://PROJEKT-REF.supabase.co
IPA_IMPORT_PUBLISHABLE_KEY=sb_publishable_UDFYLD

# Din egen administratorkonto på platformen.
IPA_IMPORT_EMAIL=fornavn.efternavn@eksempel.dk

# Mappen med PDF'erne og importliste.csv, og mappen til rapporterne. Fulde stier.
IPA_IMPORT_FOLDER=/Users/DIT-BRUGERNAVN/ipa-import/dokumenter
IPA_IMPORT_REPORTS=/Users/DIT-BRUGERNAVN/ipa-import/rapporter

# Workeren: Supavisor-værten (transaktionstilstand), login-rollen og Edge Function worker-storage.
IPA_WORKER_DB_HOST=aws-0-REGION.pooler.supabase.com
IPA_WORKER_DB_USER=ingestion_worker_login_blue.PROJEKT-REF
IPA_WORKER_STORAGE_URL=https://PROJEKT-REF.supabase.co/functions/v1/worker-storage
