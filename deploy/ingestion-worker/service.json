{
  "cluster": "${ECS_CLUSTER}",
  "serviceName": "ipa-ingestion-worker",
  "taskDefinition": "ipa-ingestion-worker",
  "desiredCount": 1,
  "launchType": "FARGATE",
  "platformVersion": "1.4.0",
  "deploymentConfiguration": {
    "minimumHealthyPercent": 100,
    "maximumPercent": 200,
    "deploymentCircuitBreaker": { "enable": true, "rollback": true }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["${PRIVATE_SUBNET_A}", "${PRIVATE_SUBNET_B}"],
      "securityGroups": ["${WORKER_SECURITY_GROUP_ID}"],
      "assignPublicIp": "DISABLED"
    }
  },
  "enableExecuteCommand": false,
  "propagateTags": "SERVICE",
  "tags": [
    { "key": "project", "value": "insurance-partners" },
    { "key": "component", "value": "ingestion-worker" }
  ]
}
