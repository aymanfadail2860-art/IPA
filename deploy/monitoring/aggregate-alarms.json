{
  "$comment": "Aggregerede alarmer (B-033, 8B-I8 C3; version 2: beta L2, B-037). Maskinlæsbar og versioneret; aggregate-alarms.md forklarer den. Ændres kun med en ny version og en beslutning i docs/decisions.md.",
  "version": 2,
  "minimumSamples": 20,
  "minimumSamplesAppliesTo": [
    "rate",
    "p95"
  ],
  "singleEventAlarms": [
    "hard_gate_regression",
    "configuration_suspended",
    "configuration_mismatch",
    "embedding_model_changed",
    "evaluation_invalid",
    "evaluation_failed",
    "publication_refused",
    "retrieval_unavailable",
    "scanner_failures",
    "malware_found",
    "dead_letter"
  ],
  "sources": {
    "retrieval": {
      "event": "retrieval",
      "where": "Vercel (appens funktioner)",
      "emittedBy": [
        "src/lib/observability/retrieval-telemetry.ts"
      ],
      "fields": [
        "request_id",
        "outcome",
        "error_code",
        "failed_steps",
        "steps_ms",
        "configuration_id",
        "provider_errors"
      ]
    },
    "job_step": {
      "event": "job_step",
      "where": "Importkørslens log (workerens stdout, deploy/import/compose.yaml)",
      "emittedBy": [
        "workers/ingestion/runtime.ts",
        "workers/ingestion/pipeline.ts",
        "src/lib/knowledge/core/provider.ts"
      ],
      "fields": [
        "step",
        "ms",
        "outcome",
        "error",
        "provider_error_kind",
        "throttled",
        "timeout",
        "http_status",
        "attempts"
      ]
    }
  },
  "alarms": [
    {
      "id": "A1",
      "name": "Embedding-fejlrate, forespørgsler",
      "kind": "rate",
      "source": "retrieval",
      "numerator": "failed_steps indeholder query_embedding",
      "denominator": "steps_ms.query_embedding findes eller failed_steps indeholder query_embedding",
      "comparator": ">",
      "threshold": 0.05,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14"
    },
    {
      "id": "A3",
      "name": "Reranking-fejlrate",
      "kind": "rate",
      "source": "retrieval",
      "numerator": "failed_steps indeholder rerank",
      "denominator": "steps_ms.rerank findes eller failed_steps indeholder rerank",
      "comparator": ">",
      "threshold": 0.01,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    },
    {
      "id": "A4",
      "name": "Reranking-latency",
      "kind": "p95",
      "source": "retrieval",
      "value": "steps_ms.rerank",
      "comparator": ">",
      "threshold": 1000,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    },
    {
      "id": "A5",
      "name": "Retrieval-latency, hele kæden",
      "kind": "p95",
      "source": "retrieval",
      "value": "steps_ms.total",
      "comparator": ">",
      "threshold": 1500,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    }
  ],
  "metricsWithoutAlarm": [],
  "removedInVersion2": {
    "note": "Beta L2 (docs/beta.md §14, B-037): AWS Bedrock er fjernet. Linjen provider_call (én pr. kald til Bedrock) og alarmerne A2 (embedding-fejlrate i ingestion) og A6 (429-rate for embedding) havde kun Bedrock som kilde. CloudWatch-alarmerne ipa-scanner-technical-failures, ipa-scanner-signatures-ageing og ipa-health-check-silent fandtes kun i ECS-udrulningen. Claude-adapteren (L4) får sine egne kald-linjer og alarmer i en ny version.",
    "alarms": [
      "A2",
      "A6"
    ],
    "sources": [
      "provider_call"
    ],
    "singleEventAlarms": [
      "ipa-scanner-technical-failures",
      "ipa-scanner-signatures-ageing",
      "ipa-health-check-silent"
    ]
  }
}
