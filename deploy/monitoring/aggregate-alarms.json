{
  "$comment": "Aggregerede alarmer (B-033, 8B-I8 C3). Maskinlæsbar og versioneret; aggregate-alarms.md forklarer den. Ændres kun med en ny version og en beslutning i docs/decisions.md.",
  "version": 1,
  "minimumSamples": 20,
  "minimumSamplesAppliesTo": ["rate", "p95"],
  "singleEventAlarms": [
    "hard_gate_regression",
    "configuration_suspended",
    "configuration_mismatch",
    "embedding_model_changed",
    "evaluation_invalid",
    "evaluation_failed",
    "publication_refused",
    "retrieval_unavailable",
    "scanner_failures",
    "ipa-scanner-technical-failures",
    "ipa-scanner-signatures-ageing",
    "malware_found",
    "dead_letter",
    "ipa-health-check-silent"
  ],
  "sources": {
    "retrieval": {
      "event": "retrieval",
      "where": "Vercel (appens funktioner)",
      "emittedBy": ["src/lib/observability/retrieval-telemetry.ts"],
      "fields": ["request_id", "outcome", "error_code", "failed_steps", "steps_ms", "configuration_id", "provider_errors"]
    },
    "provider_call": {
      "event": "provider_call",
      "where": "Vercel (appens funktioner) og CloudWatch /ipa/ingestion-worker",
      "emittedBy": ["src/lib/knowledge/providers/provider-metrics.ts", "src/lib/knowledge/core/provider.ts"],
      "fields": [
        "runtime",
        "provider",
        "operation",
        "model",
        "outcome",
        "duration_ms",
        "provider_error_kind",
        "throttled",
        "timeout",
        "retryable",
        "http_status",
        "error_class",
        "correlation_id",
        "request_id",
        "configuration_id",
        "configuration_fingerprint"
      ]
    },
    "job_step": {
      "event": "job_step",
      "where": "CloudWatch /ipa/ingestion-worker",
      "emittedBy": ["workers/ingestion/runtime.ts", "workers/ingestion/pipeline.ts", "src/lib/knowledge/core/provider.ts"],
      "fields": ["step", "ms", "outcome", "error", "provider_error_kind", "throttled", "timeout", "http_status", "attempts"]
    }
  },
  "alarms": [
    {
      "id": "A1",
      "name": "Embedding-fejlrate, forespørgsler",
      "kind": "rate",
      "source": "retrieval",
      "numerator": "failed_steps indeholder query_embedding",
      "denominator": "steps_ms.query_embedding findes eller failed_steps indeholder query_embedding",
      "comparator": ">",
      "threshold": 0.05,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14"
    },
    {
      "id": "A2",
      "name": "Embedding-fejlrate, ingestion",
      "kind": "rate",
      "source": "provider_call",
      "filter": "runtime = worker og operation = embed_document",
      "numerator": "outcome = error",
      "denominator": "alle",
      "comparator": ">",
      "threshold": 0.05,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14"
    },
    {
      "id": "A3",
      "name": "Reranking-fejlrate",
      "kind": "rate",
      "source": "retrieval",
      "numerator": "failed_steps indeholder rerank",
      "denominator": "steps_ms.rerank findes eller failed_steps indeholder rerank",
      "comparator": ">",
      "threshold": 0.01,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    },
    {
      "id": "A4",
      "name": "Reranking-latency",
      "kind": "p95",
      "source": "retrieval",
      "value": "steps_ms.rerank",
      "comparator": ">",
      "threshold": 1000,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    },
    {
      "id": "A5",
      "name": "Retrieval-latency, hele kæden",
      "kind": "p95",
      "source": "retrieval",
      "value": "steps_ms.total",
      "comparator": ">",
      "threshold": 1500,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (tærskel), B-033 (vindue og alvor)"
    },
    {
      "id": "A6",
      "name": "429-rate (throttling), embedding",
      "kind": "rate",
      "source": "provider_call",
      "filter": "operation = embed_query eller embed_document; pr. runtime",
      "numerator": "throttled = true",
      "denominator": "alle",
      "comparator": ">",
      "threshold": 0.05,
      "windowMinutes": 15,
      "severity": "warning",
      "minimumSamples": 20,
      "basis": "§14 (embedding-fejl og 429-rate, fejlrate > 5 %)"
    }
  ],
  "metricsWithoutAlarm": [
    {
      "id": "provider_timeout_rate",
      "source": "provider_call",
      "definition": "timeout = true / alle, pr. runtime og operation",
      "note": "Kan beregnes og vises. §14 fastsætter ingen tærskel, så der er ingen alarm (ingen opfundet tærskel)."
    },
    {
      "id": "provider_error_rate",
      "source": "provider_call",
      "definition": "outcome = error / alle, pr. runtime, operation og provider_error_kind",
      "note": "A2 er den for ingestion. Rerank og forespørgsler alarmeres pr. retrieval (A1 og A3)."
    }
  ]
}
