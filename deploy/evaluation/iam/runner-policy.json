{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvaluationProjectCredentials",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-central-1:${EVAL_AWS_ACCOUNT_ID}:secret:ipa/evaluation/supabase-*"
    },
    {
      "Sid": "EmbedV4ViaEuInferenceProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:eu-central-1:${EVAL_AWS_ACCOUNT_ID}:inference-profile/eu.cohere.embed-v4:0"
    },
    {
      "Sid": "EmbedV4FoundationModelOnlyThroughTheProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:eu-*::foundation-model/cohere.embed-v4:0",
      "Condition": {
        "StringEquals": { "bedrock:InferenceProfileArn": "arn:aws:bedrock:eu-central-1:${EVAL_AWS_ACCOUNT_ID}:inference-profile/eu.cohere.embed-v4:0" }
      }
    },
    {
      "Sid": "Rerank35InRegion",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:eu-central-1::foundation-model/cohere.rerank-v3-5:0"
    }
  ]
}
