# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The example env file (placeholders only, no secrets) is committed.
!.env.example

# retrieval evaluation output (docs/08b §4.5) — reports are registered, not committed
/evals/retrieval/reports/
/evals/retrieval/control-drafts/

# Beta L3: documents and import lists never belong in the repository (docs/import-runbook.md).
*.pdf
*.PDF
importliste.csv

# Beta L4b: the live test's state and reports (synthetic answers) stay local (docs/beta.md §17).
/.l4b/
